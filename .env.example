# ---------------------------------------------------------------------------
# Public configuration (safe to expose to the browser)
# ---------------------------------------------------------------------------

# Supabase project URL, found in Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key. This is a public key protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL used for SEO metadata, sitemap and absolute links.
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only configuration (never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Service-role key. Bypasses Row Level Security. Server-side only.
# Used for admin provisioning and privileged maintenance tasks.
SUPABASE_SERVICE_ROLE_KEY=

# Optional bearer secret for GET/POST /api/cron/promote.
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
# Leave empty to keep the route closed.
CRON_SECRET=

# EmailJS credentials for contact notifications and simple transactional mail.
# These are public-by-design client credentials in EmailJS, but are kept here so
# they can be rotated and are not committed to source.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
